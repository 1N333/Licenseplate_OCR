# ตั้งค่าเครื่อง Raspberry Pi (แก้ไฟล์นี้ที่เดียว ไม่ต้องพิมพ์คำสั่งยาวๆ)
# ห้ามอัปโหลดไฟล์นี้ขึ้น GitHub เพราะมีรหัสลับ

# ที่อยู่เครื่อง Dashboard (ไอพีของคอมที่รัน Next.js) พอร์ต 3000
PLATE_SERVER_URL=http://192.168.1.50:3000
# ต้องตรงกับ PLATE_API_KEY ใน .env ของ Dashboard
PLATE_API_KEY=ใส่รหัสลับตรงนี้
PLATE_SERVER_PATH=/api/detections

# ชื่อจุดติดตั้ง (แสดงบนหน้า Dashboard)
PLATE_DEVICE_ID=gate-01

# กล้อง USB: ถ้าเปิดไม่ติดลองเปลี่ยนเป็น 1 หรือ 2
CAM_INDEX=0

# ภาษา OCR
PLATE_OCR_LANG=tha+eng

# ไฟล์ทะเบียนที่รู้จัก (ให้ Pi แก้ตัวที่อ่านผิดเล็กน้อย) ลบหรือเว้นว่างถ้าไม่ใช้
PLATE_KNOWN_FILE=known_plates.txt

# 1 = ไม่เปิดหน้าต่างภาพ (เหมาะกับรันเบื้องหลังตอนเปิดเครื่อง)
# 0 = เปิดหน้าต่างแสดงภาพ (ใช้เมื่อต่อจอและเปิดแบบ desktop)
HEADLESS=1
